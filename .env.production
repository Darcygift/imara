NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://user:password@host:5432/smart_rent_db

# API Configuration
NEXT_PUBLIC_API_URL=https://api.smartrent.app
FRONTEND_URL=https://smartrent.app

# Security
JWT_SECRET=your_strong_jwt_secret_change_this_immediately
NEXTAUTH_SECRET=your_nextauth_secret_change_this_immediately
NEXTAUTH_URL=https://smartrent.app

# Payment Integration - MTN MoMo
MTN_MOMO_API_KEY=your_mtn_momo_api_key
MTN_MOMO_API_USER=your_api_user
MTN_MOMO_API_PASSWORD=your_api_password

# SMS Integration
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.sms-provider.com
SMS_FROM_NUMBER=your_sender_id

# Monitoring
SENTRY_DSN=your_sentry_dsn_for_error_tracking
LOG_LEVEL=info

# Cache & Session
REDIS_URL=redis://host:6379

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PAYMENT_GATEWAY=true
